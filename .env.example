# EventFlow Environment Variables

# PRODUCTION DEPLOYMENT CHECKLIST
# ================================
# ⚠️  Before deploying to production, you MUST complete ALL required steps:
#
# REQUIRED (App will fail without these):
# ☐ 1. Generate strong JWT_SECRET: openssl rand -base64 32
# ☐ 2. Set NODE_ENV=production
# ☐ 3. Set BASE_URL to your actual domain (https://event-flow.co.uk)
# ☐ 4. ⭐ Configure MongoDB Atlas - see detailed steps below
#      → Create free account at https://cloud.mongodb.com/
#      → Set MONGODB_URI with your actual connection string
#      → See MONGODB_SETUP_SIMPLE.md for step-by-step guide
#
# RECOMMENDED (For full functionality):
# ☐ 5. Configure email service (AWS SES, SendGrid, or SMTP)
# ☐ 6. Set EMAIL_ENABLED=true for email delivery
# ☐ 7. Set FROM_EMAIL to match your verified domain
#
# IMPORTANT: If MongoDB is not configured correctly, you will see:
# • "Failed to connect to MongoDB: Invalid scheme..." error
# • 502 Bad Gateway errors
# • "connection refused" errors
#
# 📚 Troubleshooting 502 errors? See: MONGODB_SETUP_SIMPLE.md
# 📚 Full deployment guide: DEPLOYMENT_GUIDE.md

# ============================================
# REQUIRED: Security
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_super_long_random_secret

# Encryption key for 2FA secrets and sensitive data
# If not set, will use JWT_SECRET as fallback
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_here

# Salt used alongside ENCRYPTION_KEY when deriving encryption keys.
# Optional — falls back to a fixed default salt if unset (utils/encryption.js).
# Generate with: openssl rand -base64 32
ENCRYPTION_SALT=

# Session cookie signing secret. Optional — several routes fall back to
# JWT_SECRET if unset, but setting a dedicated secret is recommended.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Shared secret required on inbound External Contacts ingestion requests
# (routes/integrations-external-contacts.js). Requests without a matching
# secret are rejected — leave unset only if that integration isn't in use.
EXTERNAL_CONTACTS_INGEST_SECRET=

# Salt used to hash device/IP fingerprints for partner referral abuse
# detection (services/partnerRegistrationRiskService.js). Optional — falls
# back to JWT_SECRET/SESSION_SECRET if unset.
PARTNER_ABUSE_HASH_SECRET=

# Salt used to anonymise viewer identifiers in Community post view counts
# (services/community.service.js). Optional — falls back to JWT_SECRET.
COMMUNITY_VIEW_SALT=

# ============================================
# Admin Authentication
# ============================================
# Owner account credentials - protected from deletion/demotion
# This account is automatically created on server startup if it doesn't exist
# Owner email (defaults to admin@event-flow.co.uk if not set)
OWNER_EMAIL=admin@event-flow.co.uk

# Owner account password
# ⚠️  REQUIRED: You MUST set this to a strong, unique password before deploying.
# The server will refuse to create the owner account in production if this is not set.
# To generate a strong password: openssl rand -base64 24
OWNER_PASSWORD=your-strong-password-here

# Admin domains for automatic admin promotion (comma-separated)
# Users with verified emails from these domains are automatically granted admin role
# Example: event-flow.co.uk,yourcompany.com
# Leave empty to disable domain-based admin promotion
ADMIN_DOMAINS=event-flow.co.uk

# ============================================
# Google sign-in (optional)
# ============================================
# OAuth 2.0 Web client ID from Google Cloud Console.
# When set, /auth shows Sign in with Google buttons and validates Google ID tokens.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Optional: comma-separated list of additional client IDs accepted by the backend.
# GOOGLE_CLIENT_IDS=web-client-id,ios-client-id

# ============================================
# Apple sign-in (optional)
# ============================================
# Services ID identifier from the Apple Developer portal (this string is the
# OAuth client_id for Sign in with Apple, e.g. uk.co.event-flow.web).
# When set, /auth shows Sign in with Apple buttons and validates Apple ID tokens.
# Full setup steps (Services ID, Return URL, domain verification): see
# docs/APPLE_SIGN_IN_WITH_APPLE.md
APPLE_CLIENT_ID=uk.co.your-domain.web
# Optional: comma-separated list of additional Services IDs accepted by the backend.
# APPLE_CLIENT_IDS=web-services-id,other-services-id

# ============================================
# Facebook sign-in (optional)
# ============================================
# App ID and App Secret from the Meta for Developers dashboard.
# When both are set, /auth shows Continue with Facebook buttons and validates
# Facebook access tokens server-side. The secret must never be exposed to the
# frontend — only FACEBOOK_APP_ID is served via /api/v1/config.
# Full setup steps (App, Facebook Login product, redirect URI, App Review):
# see docs/FACEBOOK_LOGIN_WITH_FACEBOOK.md
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Optional: override the Graph API version used for all Facebook calls.
# FACEBOOK_GRAPH_API_VERSION=v23.0

# ============================================
# Database Configuration
# ============================================
# ⚠️  PRODUCTION DEPLOYMENT: You MUST configure MongoDB Atlas
#
# For detailed setup instructions, see: MONGODB_SETUP_SIMPLE.md
# Quick start: https://github.com/rhysllwydlewis/eventflow#mongodb-setup

# ============================================
# MongoDB Atlas (Cloud Database) - REQUIRED FOR PRODUCTION
# ============================================
# 
# ⚠️  IMPORTANT: The value below is a PLACEHOLDER and will NOT work!
# You must replace it with your actual MongoDB Atlas connection string.
#
# How to get your connection string:
# 1. Create free account at https://cloud.mongodb.com/
# 2. Create a cluster (free M0 tier available)
# 3. Add a database user (Database Access → Add New Database User)
# 4. Whitelist your IP (Network Access → Add IP Address → Allow Access from Anywhere for testing)
# 5. Click "Connect" on your cluster → "Connect your application"
# 6. Copy the connection string and paste it below
# 7. Replace <username>, <password>, and <cluster-name> with your actual values
#
# Your REAL connection string will look like:
# mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
#
# ⚠️  DO NOT USE THE PLACEHOLDER BELOW - IT WILL CAUSE 502 ERRORS!
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/?appName=<ClusterName>

# ============================================
# Local MongoDB - DEVELOPMENT/TESTING ONLY
# ============================================
# This is automatically used in development if MONGODB_URI is not set
# ⚠️  NOTE: Localhost URIs are rejected in production for security
MONGODB_LOCAL_URI=mongodb://localhost:27017/eventflow

# Database name (optional, defaults to 'eventflow')
MONGODB_DB_NAME=eventflow

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# Your website URL (required for verification emails)
# Local: http://localhost:3000
# Production: https://event-flow.co.uk
# NOTE: Using localhost in production will trigger a warning
BASE_URL=http://localhost:3000

# ============================================
# Company Information (Production Config)
# ============================================
# Company registration details
# Set these before deploying to production
COMPANY_NUMBER=15123456
REGISTERED_OFFICE="123 Business St, London, W1A 1AA"
BUSINESS_PHONE=+442012345678
BUSINESS_ADDRESS_LINE1="123 Business Street"
BUSINESS_ADDRESS_LINE2="Floor 2"
BUSINESS_CITY="London"
BUSINESS_POSTCODE="EC1A 1BB"

# Cookie domain for production (optional)
# Set to your root domain (with leading dot to include subdomains) ONLY if you need cookies
# to be shared across subdomains (e.g. www.example.com and api.example.com).
# If unset, cookies are issued as host-only cookies — this is the recommended default and
# works for most single-domain deployments.
# Example: COOKIE_DOMAIN=.event-flow.co.uk
# NOTE: Do NOT set this to the old default value ".event-flow.co.uk" unless that is your
# actual production domain. An incorrect domain will prevent logout from clearing cookies.
# COOKIE_DOMAIN=

# Trust proxy setting (for Railway, Heroku, or other reverse proxies)
# Set to 'true' when running behind a proxy/load balancer to enable proper IP detection
# Required for rate limiting and X-Forwarded-For/X-Forwarded-Proto headers
# Default: 'false' for local dev, automatically 'true' on Railway (RAILWAY_ENVIRONMENT exists)
TRUST_PROXY=false

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
# WebSocket mode determines which real-time server to use
# Options:
#   v2 (default, recommended) - Modern WebSocket server with enhanced features
#     • Real-time messaging with typing indicators
#     • Read receipts and presence tracking
#     • Emoji reactions
#     • Better performance and clustering support
#   v1 (legacy) - Legacy WebSocket server for backwards compatibility
#     • Basic real-time notifications
#     • Use only if you need v1-specific client compatibility
#   off - Disable WebSocket (not recommended)
#     • Disables all real-time features
#
# IMPORTANT: Only ONE WebSocket server can run at a time to prevent crashes
# Recommended: Use 'v2' (default) for best performance and features
WEBSOCKET_MODE=v2

# WebSocket path (default: /socket.io)
# Change only if you need a custom WebSocket endpoint path
WEBSOCKET_PATH=/socket.io

# ============================================
# LEGACY MESSAGING API MODE
# ============================================
# Controls behaviour of the deprecated v1/v2/v3 messaging endpoints.
# Options:
#   read-only (default) - Write requests return HTTP 410 Gone; reads still work.
#                         Use during the migration window so clients can still
#                         fetch existing data but can no longer create/modify.
#   off       - Same as read-only (writes blocked). Reads still allowed.
#   on        - All requests forwarded (for emergency rollback only).
#                         Deprecation headers are still added on every response.
#
# See docs/LEGACY_API_SHUTDOWN.md for the migration guide.
LEGACY_MESSAGING_MODE=read-only

# Controls whether the legacy v1→MongoDB startup migration runs.
# Default: false (disabled) - the one-time migration from v1 local storage to
# MongoDB has already been completed.  Set to true only if you need to re-run it.
# LEGACY_STARTUP_MIGRATION=false

# ============================================
# EMAIL CONFIGURATION (Postmark Only)
# ============================================
# EventFlow uses Postmark exclusively for all email delivery
# Postmark provides reliable transactional email with excellent deliverability

# Enable/disable email sending
# In production, this defaults to 'true'
# In development, this defaults to 'false' (emails saved to /outbox folder)
EMAIL_ENABLED=true

# ==============================================
# POSTMARK EMAIL CONFIGURATION (REQUIRED)
# ==============================================
# Get your API key from: https://account.postmarkapp.com/api_tokens
# Documentation: https://postmarkapp.com/developer

# Your Postmark Server API Token (REQUIRED for email sending)
POSTMARK_API_KEY=your-postmark-server-token-here

# Base email domain — all sender addresses (FROM_NOREPLY, FROM_HELLO, etc.) derive from this.
# Set this to your verified domain and all addresses update automatically.
# Individual addresses can still be overridden via POSTMARK_FROM_NOREPLY, POSTMARK_FROM_HELLO, etc.
EMAIL_DOMAIN=your-domain.com

# Sender email address (REQUIRED - must be verified in Postmark)
POSTMARK_FROM=noreply@your-domain.com

# Webhook Authentication (OPTIONAL but RECOMMENDED for production)
# Set these credentials in Postmark webhook settings for security
# Generate strong random credentials and configure them in both places
# POSTMARK_WEBHOOK_USER=postmark-webhook
# POSTMARK_WEBHOOK_PASS=generate-strong-random-password-here

# ============================================
# MONGODB ATLAS WEBHOOK CONFIGURATION
# ============================================
# EventFlow can receive change events from MongoDB Atlas Database Triggers
# and App Services HTTP Endpoints via a secured webhook endpoint.
#
# Endpoint: POST /api/webhooks/mongodb
#
# How to configure in MongoDB Atlas:
# 1. Go to Atlas App Services → Triggers → Add Trigger (or HTTP Endpoint)
# 2. Set the endpoint URL to: https://your-domain.com/api/webhooks/mongodb
# 3. Generate a strong random secret: openssl rand -hex 32
# 4. Configure the trigger to include the HMAC-SHA256 signature header:
#      Header name:  X-MongoDB-Webhook-Signature
#      Header value: sha256=<HMAC-SHA256(body, secret)>
# 5. Copy the same secret into MONGODB_WEBHOOK_SECRET below
#
# Authentication: HMAC-SHA256 signature in X-MongoDB-Webhook-Signature header.
# In production the endpoint rejects all requests without a valid signature.
# In development, requests are processed even without a signature (with a warning).
#
# Disable the endpoint entirely by setting MONGODB_WEBHOOK_ENABLED=false.
MONGODB_WEBHOOK_SECRET=
# MONGODB_WEBHOOK_ENABLED=true

# Application base URL (used for verification and reset links in emails)
# Local: http://localhost:3000
# Production: https://event-flow.co.uk
APP_BASE_URL=http://localhost:3000

# Secret for unsubscribe token generation.
# REQUIRED in production — if not set, unsubscribe links are omitted from emails.
# Falls back to JWT_SECRET if UNSUBSCRIBE_SECRET is not set.
# In development only, a static fallback is used so you can test without configuring this.
# UNSUBSCRIBE_SECRET=your-separate-secret-for-unsubscribe-tokens

# ============================================
# ACTION PROMPT EMAILS (automated supplier reminders)
# ============================================
# Cron expression for the action-prompt email scheduler (default: 09:00 daily).
# Takes precedence over the cron stored in Admin → Settings → Email Automation.
# The DB value is used when this env var is not set; the job reschedules automatically.
# ACTION_PROMPTS_CRON=0 9 * * *

# Set to 'true' or '1' to force-enable the scheduler outside of production.
# In production (NODE_ENV=production) the scheduler always runs unless disabled.
# Default: off in development, on in production.
# ACTION_PROMPTS_ENABLED=false

# Hard cap on emails sent per scheduled or manual run (safety guard against bulk sends).
# Default: 500 in production, 50 in development.
# ACTION_PROMPTS_MAX_SEND_PER_RUN=500

# Expiry in days for unsubscribe link tokens (default: 30).
# ACTION_PROMPTS_UNSUBSCRIBE_TTL_DAYS=30

# Postmark message stream used for campaign (broadcast) emails.
# Defaults to 'outbound' (always available on every Postmark account).
# Set to 'broadcasts' only if you have created a dedicated broadcasts stream
# in your Postmark account (Server → Message Streams → New Stream → Broadcasts).
# CAMPAIGN_MESSAGE_STREAM=outbound

# ============================================
# OPTIONAL FEATURES
# ============================================

# ============================================
# STRIPE PAYMENT INTEGRATION
# ============================================
# EventFlow uses Stripe for secure payment processing and subscription management
# Get your API keys from: https://dashboard.stripe.com/apikeys
# Documentation: https://stripe.com/docs/js

# Stripe Secret Key (REQUIRED for backend payment processing)
# Use test keys (sk_test_...) for development
# Use live keys (sk_live_...) for production
STRIPE_SECRET_KEY=

# Stripe Publishable Key (REQUIRED for frontend Stripe.js integration)
# Use test keys (pk_test_...) for development
# Use live keys (pk_live_...) for production
# This key is exposed to the frontend via /api/payments/config
# NOTE: On Railway, you can also use NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook Secret (REQUIRED for production webhook verification)
# Get this from Stripe Dashboard > Developers > Webhooks
# Used to verify webhook signatures for security
STRIPE_WEBHOOK_SECRET=

# Payment Success URL (where users are redirected after successful payment)
# Local: http://localhost:3000/payment-success.html
# Production: https://event-flow.co.uk/payment-success.html
STRIPE_SUCCESS_URL=http://localhost:3000/payment-success.html

# Payment Cancel URL (where users are redirected if they cancel payment)
# Local: http://localhost:3000/payment-cancel.html
# Production: https://event-flow.co.uk/payment-cancel.html
STRIPE_CANCEL_URL=http://localhost:3000/payment-cancel.html

# Stripe Subscription Price IDs (for recurring subscriptions)
# Create these in Stripe Dashboard > Products > Add Product > Add Price
# Use recurring prices with monthly billing
STRIPE_PRO_PRICE_ID=

# Pro Plus plan monthly price ID (required for pro_plus subscription changes)
STRIPE_PRO_PLUS_PRICE_ID=

# Basic plan monthly price ID — LEGACY: the "basic" tier is no longer sold
# (only free/pro/pro_plus are active — see models/Subscription.js). Unused.
STRIPE_BASIC_PRICE_ID=

# Enterprise plan monthly price ID — LEGACY: the "enterprise" tier is no
# longer sold. Unused.
STRIPE_ENTERPRISE_PRICE_ID=

# Yearly billing price IDs (optional — for annual subscription discounts)
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_PLUS_YEARLY_PRICE_ID=

# Free trial length in days for new paid subscriptions (routes/subscriptions-v2.js).
# 0 or unset = no trial (current default — there is no free trial today).
# Applies to Stripe Checkout (the flow /pricing and /supplier/subscription
# actually use) for first-time subscribers only, and to the direct
# POST /api/v2/subscriptions endpoint. Does NOT implement per-customer
# trial-abuse prevention beyond "has this account had a subscription
# before" (e.g. it won't stop the same card being used for a second trial
# on a new account) — worth hardening before relying on this at volume.
STRIPE_SUBSCRIPTION_TRIAL_DAYS=0

# Enable Stripe Tax on Checkout Sessions (routes/subscriptions-v2.js).
# false/unset = off (current default — prices are charged as flat GBP
# figures with no tax line, see config/billingPlans.js PLAN_PRESENTATION).
# Only turn this on once Stripe Tax registrations are configured for the
# business in the Stripe dashboard — enabling it without them makes
# Checkout error on every session. This is a business/registration decision,
# not something this codebase can decide for you.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Stripe Coupon for Introductory Pricing
# Create in Stripe Dashboard > Products > Coupons > New Coupon
# Example: £20 off for 3 months for Professional plan intro pricing
# This allows £39/month for 3 months, then £59/month (when STRIPE_PRO_PRICE_ID is £59)
# NOTE: only wired into the legacy /api/payments/create-checkout-session route,
# which the current UI does not call — /pricing and /supplier/subscription both
# use /api/v2/subscriptions/create-checkout-session, which has no coupon support.
# Setting this alone will not make intro pricing appear anywhere in the product.
STRIPE_PRO_INTRO_COUPON_ID=

# Legacy Stripe configuration (deprecated, use new variables above). Unused.
STRIPE_SUPPLIER_PRICE_ID=

# ============================================
# TESTING STRIPE LOCALLY
# ============================================
# 1. Get test API keys from Stripe Dashboard (sk_test_... and pk_test_...)
# 2. Install Stripe CLI: https://stripe.com/docs/stripe-cli
# 3. Run: stripe listen --forward-to localhost:3000/api/payments/webhook
# 4. Copy the webhook signing secret (whsec_...) to STRIPE_WEBHOOK_SECRET
# 5. Use test card: 4242 4242 4242 4242, any future expiry, any CVC
# 6. For subscription testing, create Price IDs in Stripe Dashboard

# OpenAI (optional, for AI planning assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-mini

# Points-to-GBP conversion rate: how many points equal £1 (default: 100)
# 100 points = £1.00 (10 points = £0.10)
POINTS_PER_GBP=100

# ============================================
# MESSAGING SYSTEM CONFIGURATION
# ============================================
# Sentry DSN for error monitoring
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=
SENTRY_DSN_FRONTEND=

# Message rate limiting
MAX_MESSAGES_PER_MINUTE=30

# Redis queue backend (required in production for BullMQ workers)
# In production, set this to your managed Redis URL.
# Example: redis://default:password@redis-host:6379
REDIS_URL=
# Optional explicit namespace when environments share Redis. The default remains
# BullMQ's backwards-compatible "bull"; use a distinct value per new deployment stack.
EVENTFLOW_QUEUE_NAMESPACE=
# Dedicated queue worker process command (run separately from web process):
#   node scripts/worker.js
# Procfile and railway.worker.json already include this command.

# Spam detection keywords (comma-separated)
SPAM_KEYWORDS=viagra,cialis,casino,lottery,winner

# Message editing window in minutes
MESSAGE_EDIT_WINDOW_MINUTES=15

# Maximum pinned threads per user
MAX_PINNED_THREADS=10

# Google Maps (optional, for venue maps)
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable Maps Embed API and Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# Pexels (optional, for stock photos in admin and automatic city-page heroes)
# Get API key from: https://www.pexels.com/api/
# Used for browsing and selecting professional stock photos for category images and site content
# Suppliers still upload their own profile and package photos
PEXELS_API_KEY=

# ============================================
# SEO INSIGHTS DASHBOARD (admin: /admin-seo)
# ============================================
# Everything below is optional. With none of it set, the dashboard still
# loads but shows no data and prompts you to configure a source. The two
# blocks (Search Console, Google Ads) are independent of each other.

# --- Google Search Console: own-site performance data ---------------------
# 1. Google Cloud Console (console.cloud.google.com) -> select/create a
#    project -> APIs & Services -> Library -> enable "Google Search Console
#    API".
# 2. APIs & Services -> Credentials -> Create Credentials -> Service
#    account -> create it, then open it -> Keys -> Add Key -> Create new
#    key -> JSON. This downloads a JSON file.
# 3. Go to https://search.google.com/search-console -> select the
#    event-flow.co.uk property -> Settings -> Users and permissions ->
#    Add user -> paste the service account's "client_email" (from the
#    JSON file) -> permission level "Full".
# 4. From that same JSON file, copy "client_email" into
#    GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL below, and "private_key" into
#    GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY (keep the \n line breaks as-is —
#    they're restored automatically at runtime).
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:event-flow.co.uk
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=

# --- Google Ads API: keyword search-volume data ----------------------------
# This has more setup than Search Console because Google reviews it. Until
# it's approved, use the "Import Keyword Planner CSV" button on the
# dashboard instead (Keyword Planner UI -> Tools -> Keyword Planner ->
# Discover new keywords -> Download keyword ideas -> CSV) — no API needed.
#
# 1. developer token: sign in to Google Ads (ads.google.com) with a
#    manager (MCC) account -> Tools & Settings -> Setup -> API Center ->
#    apply for a developer token. It starts with "Test account" access
#    only; apply for "Basic" access from the same page to read real
#    account data — Google reviews this and it can take a few days.
# 2. OAuth client: Google Cloud Console -> the same project as above (or a
#    new one) -> enable "Google Ads API" -> APIs & Services -> Credentials
#    -> Create Credentials -> OAuth client ID -> Application type
#    "Desktop app".
# 3. refresh token: run Google's OAuth installed-app flow once, granting
#    the https://www.googleapis.com/auth/adwords scope, using the client
#    id/secret from step 2. Google's own guide walks through this:
#    https://developers.google.com/google-ads/api/docs/oauth/cloud-project
#    (the "Generate a refresh token" section — a one-off manual step, the
#    refresh token itself doesn't expire under normal use).
# 4. customer id: the 10-digit id shown top-right in the Google Ads UI
#    for the account whose data you want (digits only, no dashes).
# 5. GOOGLE_ADS_LOGIN_CUSTOMER_ID: only needed if the account in step 4 is
#    managed under a separate manager/MCC account — set it to the
#    manager's id in that case, otherwise leave blank.
# 6. GOOGLE_ADS_API_VERSION: check the current supported version at
#    https://developers.google.com/google-ads/api/docs/release-notes
#    (e.g. "v21") — deliberately not defaulted in code, since Google
#    retires versions on a roughly yearly cycle.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=

# ============================================
# PHONE VERIFICATION (TWILIO)
# ============================================
# Twilio credentials for SMS-based phone verification
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+441234567890

# ============================================
# FOUNDER BADGE & PROFILE SETTINGS
# ============================================
# Launch timestamp for founder badge eligibility (ISO 8601 format)
# Users who register within 6 months of this date receive the founder badge
# Example: 2026-01-01T00:00:00Z
FOUNDER_LAUNCH_TS=2026-01-01T00:00:00Z

# Avatar upload settings
# Maximum file size in megabytes
AVATAR_MAX_MB=5

# Allowed image types (comma-separated)
AVATAR_ALLOWED_TYPES=jpeg,jpg,png,webp

# Avatar storage path (relative to project root)
AVATAR_STORAGE_PATH=uploads/avatars

# Upload file size limits (in MB)
# Separate limits for different upload contexts
MAX_FILE_SIZE_MARKETPLACE_MB=10
MAX_FILE_SIZE_SUPPLIER_MB=10
MAX_FILE_SIZE_AVATAR_MB=5

# Maximum pixel count for images (prevents decompression bombs)
# Default: 25 megapixels (25000000 pixels)
MAX_PIXEL_COUNT=25000000

# Additional CORS origins (comma-separated)
# Allows multiple origins beyond BASE_URL
# Example: https://preview.mysite.com,https://staging.mysite.com
# ALLOWED_ORIGINS=

# ============================================
# ALTCHA CAPTCHA CONFIGURATION
# ============================================
# ALTCHA is a privacy-focused, self-hosted CAPTCHA alternative using proof-of-work.
# Generate a strong HMAC key: openssl rand -base64 32
# ALTCHA_HMAC_KEY=your_altcha_hmac_key_here

# ============================================
# EXPORT CONFIGURATION
# ============================================
# Set DISABLE_XLSX_EXPORT=true to disable XLSX export in hardened environments.
# When enabled, XLSX export requests fall back to CSV and the xlsx package is not loaded.
# DISABLE_XLSX_EXPORT=false

# ============================================
# NOTES
# ============================================

# For Postmark:
# 1. Sign up at https://postmarkapp.com
# 2. Get your Server API Token from Account > API Tokens
# 3. Verify your sender email/domain at Sender Signatures
# 4. Configure POSTMARK_API_KEY and POSTMARK_FROM in Railway dashboard
# 5. DO NOT hardcode real API keys in this file or commit them to git
# 6. For local development, create a .env file (not tracked in git) with your keys

# Testing locally:
# - Set EMAIL_ENABLED=false to test without sending real emails
# - Verification links will be shown in the API response
# - Email files are saved to /outbox folder for inspection

# ============================================
# POSTMARK WEBHOOKS / EMAIL CENTRE
# ============================================
# Configure these same Basic Auth credentials in Postmark webhook settings.
# Enable Delivered, Opened, LinkClicked, Bounced, SpamComplaint and SubscriptionChanged events.
POSTMARK_WEBHOOK_USER=postmark-webhook
POSTMARK_WEBHOOK_PASS=generate-strong-random-password-here
POSTMARK_WEBHOOK_ENABLED=true
POSTMARK_EMAIL_LOG_RETENTION_DAYS=365
