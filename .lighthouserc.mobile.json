{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.js",
      "startServerReadyPattern": "Static server running",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/marketplace",
        "http://localhost:3000/pricing",
        "http://localhost:3000/suppliers"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.6
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
