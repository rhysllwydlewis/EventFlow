{
  "ci": {
    "collect": {
      "startServerCommand": "bash scripts/start-lighthouse-server.sh",
      "startServerReadyPattern": "Lighthouse server warmed",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/marketplace",
        "http://localhost:3000/pricing",
        "http://localhost:3000/suppliers"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "pessimistic"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.8,
                "aggregationMethod": "pessimistic"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "pessimistic"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/suppliers$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.35,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.7,
                "aggregationMethod": "pessimistic"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.5,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/(marketplace|pricing)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.6,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}