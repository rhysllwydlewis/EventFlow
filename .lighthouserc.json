{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.js",
      "startServerReadyPattern": "Static server running",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/marketplace",
        "http://localhost:3000/pricing",
        "http://localhost:3000/suppliers",
        "http://localhost:3000/guides",
        "http://localhost:3000/articles/wedding-venue-selection-guide"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.7,
                "aggregationMethod": "pessimistic"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "pessimistic"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "pessimistic"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/(guides(?:$|/)|articles/.*)",
          "assertions": {
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.7,
                "aggregationMethod": "pessimistic"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/(?!guides(?:$|/)|articles/).*",
          "assertions": {
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "pessimistic"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
