{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'node scripts/preflight.mjs && exec node -r ./services/deploymentMetadataPreload.js server.js'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 120
  },
  "environments": {
    "production": {
      "variables": {
        "NODE_ENV": "production",
        "BASE_URL": "https://event-flow.co.uk",
        "CANONICAL_BASE_URL": "https://event-flow.co.uk",
        "RAILWAY_STATIC_URL": "https://event-flow.co.uk",
        "RAILWAY_TELEMETRY_BOOTSTRAP_CONTRACT": "node -r ./services/backgroundJobTelemetryBridge.js server.js"
      }
    }
  }
}
